# Which cloud provider to use as primary: anthropic | openai | groq
LLM_PROVIDER=anthropic

# Only the key for your chosen provider is required
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.1-8b-instant

# Local fallback (requires Ollama running locally: https://ollama.com)
ENABLE_LOCAL_FALLBACK=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security tuning
MAX_MESSAGE_LENGTH=4000
RATE_LIMIT_PER_MINUTE=20
INJECTION_BLOCK_THRESHOLD=0.6

# CORS - comma-separated origins allowed to call the API
ALLOWED_ORIGINS=["http://localhost:5173"]
